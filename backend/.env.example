# Application Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Database Configuration
# For PostgreSQL (Production/Hackathon):
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/college_hub
# For Zero-Config Local SQLite fallback (leave blank or use sqlite):
# DATABASE_URL=sqlite:///./college_hub.db

# JWT Security
SECRET_KEY=college_notification_hub_hackathon_super_secret_key_2026_jwt_token
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# OpenAI-Compatible AI Service
# Any OpenAI-compatible provider (OpenAI, Groq, Ollama, DeepSeek, OpenRouter, vLLM)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# CORS Configuration (comma-separated or * for all)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,*
